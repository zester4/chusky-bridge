# Chusky Bridge configuration. Every setting is CHUSKY_<NAME>. See docs/configuration.md.

CHUSKY_ENV=development                 # development | staging | production
CHUSKY_PUBLIC_BASE_URL=http://localhost:8000
CHUSKY_LOG_LEVEL=INFO
CHUSKY_LOG_JSON=true
CHUSKY_METRICS_ENABLED=true

CHUSKY_DATABASE_URL=postgresql://chusky:chusky@localhost:5432/chusky
CHUSKY_REDIS_URL=redis://localhost:6379/0

CHUSKY_JWT_JWKS_URL=http://localhost:8080/realms/chusky/protocol/openid-connect/certs
CHUSKY_JWT_ISSUER=http://localhost:8080/realms/chusky
CHUSKY_JWT_AUDIENCE=chusky-bridge-mcp
CHUSKY_JWT_ALGORITHMS=["RS256","ES256"]

# Secrets: env (development only), vault, or aws. Production refuses env.
CHUSKY_SECRET_VAULT_PROVIDER=env
# CHUSKY_SECRET_LEGACY_ERP_DB=Driver={ODBC Driver 18 for SQL Server};Server=erp;Database=erp;UID=svc;PWD=...
# CHUSKY_VAULT_ADDR=https://vault.internal:8200
# CHUSKY_VAULT_TOKEN=
# CHUSKY_VAULT_MOUNT=secret
# CHUSKY_VAULT_PREFIX=chusky
# CHUSKY_AWS_REGION=us-east-1
# CHUSKY_AWS_SECRET_PREFIX=chusky/

CHUSKY_MAX_TOOL_RESPONSE_BYTES=100000
CHUSKY_ENABLE_WRITE_TOOLS=false
CHUSKY_APPROVAL_TTL_SECONDS=900
CHUSKY_RATE_LIMIT_BACKEND=memory       # memory | redis
CHUSKY_RATE_LIMIT_PER_MINUTE=60

CHUSKY_WSDL_DIR=/etc/chusky-bridge/wsdl
CHUSKY_CERT_DIR=/etc/chusky-bridge/certs

CHUSKY_BOOTSTRAP_TENANT_NAME=default
CHUSKY_MANIFEST_DIR=connectors_manifests
CHUSKY_LOAD_MANIFESTS_ON_START=true
